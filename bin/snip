#!/bin/sh
# Snipping-tool style capture for wlroots compositors (labwc):
#   snip          -> drag to select a region
#   snip full     -> whole screen
# Saves to ~/Pictures/Screenshots and copies the image to the clipboard.
dir="$HOME/Pictures/Screenshots"; mkdir -p "$dir"
f="$dir/$(date +%F_%H-%M-%S).png"
if [ "$1" = full ]; then
  grim "$f"
else
  region=$(slurp) || exit 0   # Esc cancels
  grim -g "$region" "$f"
fi && wl-copy --type image/png < "$f"

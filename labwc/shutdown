# Run by labwc as it exits, which in this session is when lxqt-session ends
# normally (logout). Power-off and reboot kill the session instead, so they
# rely on the user manager stopping the unit below.

# Office lamp off: stops ha-login-light-lxqt.service (HA webhook Loff).
systemctl --user stop ha-login-light-lxqt.service >/dev/null 2>&1

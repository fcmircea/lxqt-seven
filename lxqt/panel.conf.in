[General]
__userfile__=true
iconTheme=

[fancymenu]
favorites\1\desktopFile=@HOME@/.local/share/applications/com.anthropic.Claude.desktop
favorites\2\desktopFile=/var/lib/snapd/desktop/applications/firefox_firefox.desktop
favorites\size=2

[mount]
alignment=Right

[panel1]
alignment=-1
animation-duration=0
background-color=@Variant(\0\0\0\x43\0\xff\xff\0\0\0\0\0\0\0\0)
background-image=
desktop=0
font-color=@Variant(\0\0\0\x43\0\xff\xff\0\0\0\0\0\0\0\0)
hidable=false
hide-on-overlap=false
iconSize=28
lineCount=1
lockPanel=false
opacity=100
panelSize=40
plugins=fancymenu, quicklaunch, taskbar, statusnotifier, tray, mount, volume, worldclock, showdesktop
position=Top
reserve-space=true
screen-name=HDMI-A-1
show-delay=0
visible-margin=true
width=100
width-percent=true

[quicklaunch]
alignment=Left
apps\1\desktop=@HOME@/.local/share/applications/com.anthropic.Claude.desktop
apps\2\desktop=/usr/share/applications/qterminal.desktop
apps\3\desktop=/usr/share/applications/pcmanfm-qt.desktop
apps\4\desktop=/var/lib/snapd/desktop/applications/firefox_firefox.desktop
apps\size=4
type=quicklaunch

[taskbar]
alignment=Left
buttonStyle=Icon
buttonWidth=60
groupingEnabled=false
showGroupOnHover=true

[volume]
alignment=Right

[worldclock]
alignment=Right
customFormat='<b>'HH:mm'</b><br/><small>'dd.MM.yyyy'</small>'
formatType=custom

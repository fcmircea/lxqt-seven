+QString LXQtNetworkMonitor::linkSpeed(const QString &interface)
+{
+#ifdef STATGRAB_NEWER_THAN_0_90
+    size_t count;
+    size_t x;
+#else
+    int count;
+    int x;
+#endif
+    sg_network_iface_stats *stats = sg_get_network_iface_stats(&count);
+
+    for (x = 0; x < count; x++)
+    {
+        if (interface != QString::fromLocal8Bit(stats[x].interface_name))
+            continue;
+
+        if (stats[x].up != SG_IFACE_UP)
+            return tr("Link down");
+
+        // ethtool reports SPEED_UNKNOWN (-1) for links that negotiated nothing, e.g. Wi-Fi
+        if (stats[x].speed == 0 || stats[x].speed >= 0xFFFFFFFF)
+            return tr("Link speed unknown");
+
+#ifdef STATGRAB_NEWER_THAN_0_90
+        double mbps = double(stats[x].speed) * stats[x].factor / 1000000;
+#else
+        double mbps = stats[x].speed;
+#endif
+        QString speed = mbps >= 1000
+            ? QString::number(mbps / 1000, 'g', 3) + QStringLiteral(" Gbit/s")
+            : QString::number(mbps, 'g', 4) + QStringLiteral(" Mbit/s");
+
+        QString duplex;
+        if (stats[x].duplex == SG_IFACE_DUPLEX_FULL)
+            duplex = tr("full duplex");
+        else if (stats[x].duplex == SG_IFACE_DUPLEX_HALF)
+            duplex = tr("half duplex");
+
+        return duplex.isEmpty() ? tr("Link speed %1").arg(speed)
+                                : tr("Link speed %1, %2").arg(speed, duplex);
+    }
+
+    return tr("Link speed unknown");
+}
